.env
.env.local
compose.override.yml
.tmp*/
# `data/` is intentionally NOT ignored. The scratch-dir guard in
# scripts/lib-scratch.sh forbids scratch from resolving anywhere but .tmp/,
# so a stray data/ should stay visible (untracked) and get noticed, never
# silently committed or hidden behind an ignore rule.
node_modules/
**/node_modules/
logs/*
!logs/.gitkeep
!logs/*/.gitkeep
build/*
!build/.gitkeep
!build/README.md
test/**/results/
test/**/playwright-report/
test/**/test-results/
test/**/.last-run.json
services/onboard-helper/target/
CLAUDE.md
.codex
.superpowers/
.DS_Store
NOTES.md
!dev/audit/NOTES.md
!dev/audit/**/NOTES.md
TODO.md

# Audit run output — methodology (rules/, templates/) stays tracked; live
# findings + archived runs do not enter the public tree.
dev/audit/findings/
dev/audit/archive/

# Hand-off scratch (per-machine, not tracked)
HANDOFF.md
.sessions/

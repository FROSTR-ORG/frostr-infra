{
  "name": "frostr-infra-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "npm run test:e2e:fast && npm run test:e2e:live",
    "test:guards": "npm run test:guards:targets && npm run test:guards:wasm",
    "test:guards:full": "npm run test:guards:docs && npm run test:guards:workflows && npm run test:guards:shared-setup && npm run test:guards:targets && npm run test:guards:wasm && npm run test:guards:selectors && npm run test:guards:visual && bash ./scripts/test-run-sh.sh && bash ./scripts/test-igloo-home-run-e2e.sh && bash ./scripts/test-affected.sh",
    "test:verify": "npm run test:guards && npm run test:typecheck && npm run test:e2e:fast",
    "test:guards:docs": "node ./scripts/check-markdown-links.mjs && bash ./scripts/check-no-legacy-surfaces.sh && bash ./scripts/check-doc-surfaces.sh && bash ./scripts/check-doc-command-surfaces.sh",
    "test:guards:workflows": "bash ./scripts/check-workflow-node24-actions.sh && bash ./scripts/check-client-scoped-submodules.sh",
    "test:guards:shared-setup": "bash ./scripts/check-shared-test-setup.sh",
    "test:guards:targets": "bash ./scripts/check-test-targets.sh",
    "test:guards:wasm": "bash ./scripts/check-browser-wasm-harness-contracts.sh && bash ./scripts/check-browser-wasm-stamp.sh",
    "test:guards:wasm:strict": "bash ./scripts/check-test-prebuild-nonmutating.sh",
    "test:guards:selectors": "bash ./scripts/check-cross-client-imports.sh && bash ./scripts/check-e2e-selector-contracts.sh",
    "test:guards:visual": "node ./scripts/check-pwa-visual-manifest.mjs && bash ./scripts/check-pwa-visual-manifest-negative.sh",
    "test:guards:pwa": "bash ./scripts/check-browser-wasm-artifacts.sh pwa && bash ./scripts/check-e2e-selector-contracts.sh pwa && bash ./scripts/test-affected.sh",
    "test:guards:chrome": "bash ./scripts/check-browser-wasm-artifacts.sh chrome && bash ./scripts/check-e2e-selector-contracts.sh chrome && bash ./scripts/test-affected.sh",
    "test:guards:home": "bash ./scripts/test-igloo-home-run-e2e.sh && bash ./scripts/test-affected.sh",
    "test:e2e:igloo-home": "bash ./igloo-home/run-e2e.sh",
    "test:igloo-ui-showcase": "playwright test -c ./igloo-ui-showcase/playwright.config.ts",
    "test:e2e:igloo-pwa": "playwright test -c ./igloo-pwa/playwright.config.ts --grep-invert @cross-client",
    "test:e2e:igloo-pwa:fast": "FROSTR_TEST_LANE=fast playwright test -c ./igloo-pwa/playwright.config.ts --grep-invert \"@live|@cross-client|@agent\"",
    "test:screenshot": "FROSTR_TEST_LANE=fast playwright test -c ./igloo-pwa/playwright.config.ts --grep @agent",
    "test:e2e:igloo-pwa:live": "playwright test -c ./igloo-pwa/playwright.config.ts --grep @live",
    "test:e2e:igloo-pwa:cross": "playwright test -c ./igloo-pwa/playwright.config.ts --grep @cross-client",
    "test:e2e:igloo-pwa:visual": "playwright test -c ./igloo-pwa/playwright.config.ts --grep @visual",
    "test:visual:report": "node ./scripts/report-pwa-visual-comparison.mjs",
    "test:e2e:smoke": "bash ./scripts/test-demo-harness-onboard.sh",
    "test:e2e:fast": "npm run test:e2e:igloo-pwa:fast && npm run test:e2e:igloo-chrome:fast",
    "test:e2e:live": "npm run test:e2e:igloo-pwa:live && npm run test:e2e:igloo-chrome:live",
    "test:e2e:demo": "npm run test:e2e:igloo-chrome:demo",
    "test:e2e:igloo-chrome": "playwright test -c ./igloo-chrome/playwright.config.ts",
    "test:e2e:igloo-chrome:demo": "IGLOO_DEMO_LIVE_REPRO=1 playwright test -c ./igloo-chrome/playwright.config.ts --grep @demo",
    "test:e2e:igloo-chrome:fast": "FROSTR_TEST_LANE=fast playwright test -c ./igloo-chrome/playwright.config.ts --grep-invert \"@live|@cross-client\"",
    "test:e2e:igloo-chrome:live": "playwright test -c ./igloo-chrome/playwright.config.ts --grep @live",
    "test:typecheck": "npm run test:typecheck:pwa && npm run test:typecheck:chrome && npm run test:typecheck:home && npm run test:typecheck:strict-support",
    "test:typecheck:pwa": "tsc --noEmit -p tsconfig.pwa.json",
    "test:typecheck:chrome": "tsc --noEmit -p tsconfig.chrome.json",
    "test:typecheck:home": "tsc --noEmit -p tsconfig.home.json",
    "test:typecheck:strict-support": "npm run test:typecheck:strict-helpers && npm run test:typecheck:strict-visual-specs",
    "test:typecheck:strict-helpers": "tsc --noEmit -p tsconfig.strict-helpers.json",
    "test:typecheck:strict-visual-specs": "tsc --noEmit -p tsconfig.strict-visual-specs.json",
    "test:run-sh": "bash ./scripts/test-run-sh.sh",
    "test:install-browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@noble/curves": "^2.2.0",
    "@playwright/test": "^1.60.0",
    "@scure/base": "^1.2.6",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "igloo-shared": "file:../repos/igloo-shared",
    "nostr-tools": "^2.17.2",
    "typescript": "^5.9.3",
    "ws": "^8.20.1"
  }
}

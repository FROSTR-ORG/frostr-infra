<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant manifest overlay.

  Adds debug-only intent filters for test automation actions to MainActivity.
  These actions are consumed only in debug builds; release builds use the
  default `src/main/AndroidManifest.xml` and gain no test entry points. This
  file is merged into the main manifest at assembleDebug time.

  The action is paired with a custom category so that only test tooling (adb am
  start / Maestro helper scripts) targeting this exact category will activate
  the path. End-user launchers cannot invoke the test-inject entry point,
  because the custom action is not advertised in the LAUNCHER intent-filter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="com.frostr.igloo.MainActivity"
            android:exported="true"
            tools:ignore="ExportedActivity">
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_INJECT_ONBOARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_SAVE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_SAVE_TO_DASHBOARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_EXPORT_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_LOAD_PROFILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_LOAD_PROFILE_CONFIRM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_CREATE_KEYSET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_KEYSET_DISTRIBUTE_PASSWORD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_KEYSET_DISTRIBUTE_SUBMIT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_KEYSET_DISTRIBUTE_FINISH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_ROTATE_SHARE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.frostr.igloo.DEBUG_TEST_ROTATE_SHARE_REPLACE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
